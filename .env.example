# ================================
# تنظیمات سرور HTTP و WebSocket
# ================================
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
SERVER_URL=http://localhost:8080
WS_URL=ws://localhost:8080

# ================================
# احراز هویت و امنیت ادمین
# ================================
ADMIN_API_TOKEN=change_this_admin_api_token
ADMIN_SECRET_CODE=11228
ADMIN_SESSION_TTL_MS=86400000

# ================================
# پایداری وضعیت (State Persistence)
# ================================
STATE_FILE_PATH=./casino-state.json
STATE_SAVE_INTERVAL_MS=5000

# ================================
# پشتیبان‌گیری و همگام‌سازی (Backup & Restore)
# ================================
BACKUP_DIR=./backups
REMOTE_BACKUP_TARGET=
BACKUP_RETENTION_DAYS=14

# مسیر اندپوینت‌های HTTP ادمین برای مدیریت پشتیبان‌ها
ADMIN_BACKUPS_LIST_PATH=/api/admin/backups
ADMIN_BACKUPS_CREATE_PATH=/api/admin/backups
ADMIN_BACKUPS_RESTORE_PATH=/api/admin/backups/restore
ADMIN_BACKUPS_DELETE_PATH=/api/admin/backups/:id

# ================================
# تنظیمات PM2
# ================================
PM2_APP_NAME=sofyan-60bet-server
PM2_MAX_MEMORY_RESTART=512M
PM2_LOG_DIR=./logs

# ================================
# تنظیمات اجرای تست‌ها (Unit / E2E / Consistency)
# ================================
TEST_USER=
TEST_PASS=
TOPUP_AMOUNT=100000
BET_AMOUNT=10000
CHAT_TEXT=
BACKUP_ID=
